---
import Base from "../layouts/Base.astro";
import { logements, formatFCFA } from "../data/logements.js";
---

<Base>
  <h1 class="text-3xl font-bold md:text-4xl">Trouvez votre logement à Libreville</h1>
  <p class="mt-2 text-slate-600">
    Étape 1 : fondations en place. {logements.length} logements de démonstration chargés.
  </p>

  <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {logements.slice(0, 3).map((l) => (
      <article class="carte p-4">
        <p class="text-sm font-medium text-slate-600">{l.quartier}</p>
        <h2 class="mt-1 text-lg font-bold">{l.titre}</h2>
        <p class="mt-2 text-xl font-extrabold">
          {formatFCFA(l.loyer)}<span class="text-sm font-medium text-slate-600"> / mois</span>
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          {l.edan && <span class="badge">EDAN individuel</span>}
          {l.forage && <span class="badge">Forage / Eau H24</span>}
          {l.coursFermee && <span class="badge">Cour fermée</span>}
        </div>
      </article>
    ))}
  </div>

  <div class="mt-8 flex gap-3">
    <button class="btn-primary">Bouton principal</button>
    <button class="btn-secondary">Bouton secondaire</button>
  </div>
</Base>
